---
import { strings, altLang, altPath, type Lang } from '../i18n/strings';
interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const s = strings[lang];
const { pathname } = Astro.url;
const prefix = lang === 'hr' ? '/hr' : '';
const links = [
  { href: `${prefix}/`, label: s.nav.about },
  { href: `${prefix}/publications/`, label: s.nav.research },
  { href: `${prefix}/projects/`, label: s.nav.projects },
  { href: `${prefix}/teaching/`, label: s.nav.teaching },
  // Static Quarto site served verbatim from public/ai/ — English only, so no locale prefix.
  { href: '/ai/', label: s.nav.ai },
];
const isActive = (p: string) => {
  if (p === `${prefix}/`) return pathname === p;
  return pathname === p || pathname.startsWith(p);
};
const altHref = lang === 'hr' && pathname.startsWith('/hr/404')
  ? '/404.html'
  : altPath(pathname, lang);
const other = altLang(lang);
---
<nav class="nav" aria-label="Primary">
  <div class="nav__inner">
    <a class="nav__brand" href={`${prefix}/`}><span class="dot"></span> {s.brand}</a>
    <div class="nav__links">
      {links.map(l => (
        <a class="nav__link" href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <a class="nav__link" href={altHref} aria-label={other === 'hr' ? 'Hrvatski' : 'English'}>{other.toUpperCase()}</a>
      <button class="nav__theme-toggle" id="themeToggle" type="button" aria-label={s.nav.theme} title={s.nav.theme} aria-pressed="false">
        <svg class="theme-icon theme-icon--moon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" stroke-linejoin="round"/>
        </svg>
        <svg class="theme-icon theme-icon--sun" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="3.5" />
          <path d="M12 2V5M12 19V22M2 12H5M19 12H22M4.9 4.9L7 7M17 17L19.1 19.1M19.1 4.9L17 7M7 17L4.9 19.1" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</nav>
