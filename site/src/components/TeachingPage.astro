---
import Base from '../layouts/Base.astro';
import SectionHeader from './SectionHeader.astro';
import { strings, type Lang } from '../i18n/strings';
import { currentCourses, localize, previousCourses, workshops } from '../data/portfolio';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = strings[lang];
---
<Base title={s.teaching.title} lang={lang}>
  <section class="hero hero--compact">
    <span class="hero__eyebrow eyebrow">{s.teaching.eyebrow}</span>
    <h1 class="hero__title hero__title--page">{s.teaching.heroTitle}</h1>
    <p class="hero__lede" set:html={s.teaching.hero} />
  </section>

  <section class="section section--flush">
    <SectionHeader num={s.teaching.currentLabel} title={s.teaching.currentTitle} />
    <ul class="list">
      {currentCourses.map(co => (
        <li>
          <div class="teach">
            <div class="teach__term">
              <div>{co.term}</div>
              <div class="teach__code">{localize(co.code, lang)}</div>
            </div>
            <div>
              <div class="teach__course">
                <a href={co.href} target="_blank" rel="noopener">{localize(co.title, lang)}</a>
              </div>
              <span class="teach__inst">{localize(co.institution, lang)}</span>
              <p class="teach__desc">{localize(co.description, lang)}</p>
            </div>
            <a class="teach__link" href={co.href} target="_blank" rel="noopener">{s.teaching.materials}</a>
          </div>
        </li>
      ))}
    </ul>
    <p class="teaching__student-note" set:html={s.teaching.studentNote} />
  </section>

  <section class="section">
    <SectionHeader num={s.teaching.previousLabel} title={s.teaching.previousTitle} />
    <ul class="list">
      {previousCourses.map(co => (
        <li>
          <div class="teach">
            <div class="teach__term">
              <div>{co.term}</div>
              <div class="teach__code">{localize(co.code, lang)}</div>
            </div>
            <div>
              <div class="teach__course">
                <a href={co.href} target="_blank" rel="noopener">{localize(co.title, lang)}</a>
              </div>
              <span class="teach__inst">{localize(co.institution, lang)}</span>
              <p class="teach__desc">{localize(co.description, lang)}</p>
            </div>
            <a class="teach__link" href={co.href} target="_blank" rel="noopener">{s.teaching.materials}</a>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" id="workshops">
    <SectionHeader num={s.teaching.workshopsLabel} title={s.teaching.workshopsTitle} />
    <div class="prose prose--narrow">
      <p set:html={s.teaching.workshopsBody} />
    </div>
    <ul class="list list--spaced">
      {workshops.map(w => (
        <li>
          <div class="teach">
            <div class="teach__term">
              <div>{localize(w.term, lang)}</div>
              <div class="teach__code">{localize(w.code, lang)}</div>
            </div>
            <div>
              <div class="teach__course">
                <a href={w.links[0].href} target="_blank" rel="noopener">{localize(w.title, lang)}</a>
              </div>
              <span class="teach__inst">{localize(w.institution, lang)}</span>
              <p class="teach__desc">{localize(w.description, lang)}</p>
            </div>
            <div class="teach__links">
              {w.links.map(l => (
                <a class="teach__link" href={l.href} target="_blank" rel="noopener">{localize(l.label, lang)}</a>
              ))}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>
