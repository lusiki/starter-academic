  '0,56 25,54.5 50,51 75,48.5 100,47.2 125,43.7 150,44 175,46 200,43.4 225,42.6 250,44.5 275,43.8 300,44.3 325,40.7 350,37.1 375,38.5 400,38.4 425,34.9 450,32.1 475,29.7 500,30.3 525,31 550,30.5 575,30.9 600,31.9 625,31.9 650,32.7 675,29.6 700,29 725,25.7 750,26.3 775,26.3 800,27 825,24.6 850,22.4 875,18.8 900,18 925,19.3 950,20.9 975,22.3 1000,20.4 1025,21.4 1050,21.8 1075,18.7 1100,20 1125,18.3 1150,16.4 1175,17 1200,17.2';
---
<div class="signal-band" aria-hidden="true">
  <svg class="signal-band__svg" viewBox="0 0 1200 72" preserveAspectRatio="none" focusable="false">
    {traces.map((points, i) => (
      <polyline
        class={`signal-band__trace signal-band__trace--${i + 1}`}
        points={points}
        pathLength="1"
        fill="none"
        vector-effect="non-scaling-stroke"
      />
    ))}
    <polyline
      class="signal-band__trace signal-band__trace--accent"
      points={accent}
      pathLength="1"
      fill="none"
      vector-effect="non-scaling-stroke"
    />
  </svg>
  <span class="signal-band__point"></span>
</div>
