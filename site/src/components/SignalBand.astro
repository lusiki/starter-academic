  '0,20 25,18.3 50,22 75,21.2 100,18.1 125,15.8 150,18.3 175,20.8 200,19.8 225,22 250,24.9 275,28.8 300,29.6 325,31.3 350,31.2 375,34.3 400,34.9 425,32.1 450,33.8 475,32.1 500,30.9 525,29.2 550,26.6 575,27 600,30.9 625,29 650,32.4 675,31.7 700,28.9 725,30.1 750,32.1 775,29 800,27.6 825,26.7 850,25.1 875,27.8 900,25.9 925,29.1 950,28.4 975,31.7 1000,28.6 1025,31.5 1050,32.2 1075,34.4 1100,36.4 1125,36.5 1150,37.9 1175,39.5 1200,36.7',
