---
import Base from '../layouts/Base.astro';
import { render, type CollectionEntry } from 'astro:content';
import { strings, type Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'publications'>;
}

const { lang, entry } = Astro.props;
const s = strings[lang];
const prefix = lang === 'hr' ? '/hr' : '';
const { Content } = await render(entry);
const d = entry.data;
const year = d.date.getFullYear();
const abstract = (lang === 'hr' && d.abstract_hr) ? d.abstract_hr : d.abstract;
const typeFallback = lang === 'hr' ? 'Publikacija' : 'Publication';
const projectHref = d.url_project?.startsWith('/')
  ? `${prefix}${d.url_project}`
  : d.url_project;
const projectIsExternal = Boolean(projectHref?.startsWith('http'));
---
<Base title={`${d.title} — Luka Šikić`} description={abstract?.slice(0, 200)} lang={lang}>
  <article class="prose detail-page">
    <div class="detail-page__back">
      <a href={`${prefix}/publications/`} class="eyebrow">{s.pubs.back}</a>
    </div>

    <div class="eyebrow detail-page__meta">
      {year} · {d.publication_type || typeFallback}
    </div>

    <h1 class="detail-page__title">{d.title}</h1>

    {d.authors.length > 0 && (
      <p class="mono detail-page__authors">{d.authors.join(' · ')}</p>
    )}

    {d.publication && (
      <p class="detail-page__venue" set:html={d.publication.replace(/_([^_]+)_/g, '<em>$1</em>')} />
    )}

    <div class="detail-page__actions">
      {d.url_pdf && <a class="btn" href={d.url_pdf} target="_blank" rel="noopener">PDF</a>}
      {d.url_code && <a class="btn" href={d.url_code} target="_blank" rel="noopener">{lang === 'hr' ? 'Kod' : 'Code'}</a>}
      {d.url_preprint && <a class="btn" href={d.url_preprint} target="_blank" rel="noopener">Preprint</a>}
      {d.url_slides && <a class="btn" href={d.url_slides} target="_blank" rel="noopener">{lang === 'hr' ? 'Prezentacija' : 'Slides'}</a>}
      {projectHref && (
        <a
          class="btn"
          href={projectHref}
          target={projectIsExternal ? '_blank' : undefined}
          rel={projectIsExternal ? 'noopener' : undefined}
        >
          {projectIsExternal
            ? (lang === 'hr' ? 'Analiza' : 'Analysis')
            : (lang === 'hr' ? 'Projekt' : 'Project')}
        </a>
      )}
      {d.doi && <a class="btn" href={`https://doi.org/${d.doi}`} target="_blank" rel="noopener">DOI</a>}
    </div>

    {abstract && (
      <>
        <div class="eyebrow detail-page__section-label">{s.pubs.abstract}</div>
        <p>{abstract}</p>
      </>
    )}

    {d.tags.length > 0 && (
      <div class="detail-page__tags">
        {d.tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
    )}

    <Content />

    {d.bibtex && (
      <>
        <div class="eyebrow detail-page__section-label">{s.pubs.bibtex}</div>
        <pre>{d.bibtex}</pre>
      </>
    )}
  </article>
</Base>
