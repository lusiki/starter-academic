---
import '../styles/colors_and_type.css';
import '../styles/components.css';
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { altPath, strings, type Lang } from '../i18n/strings';
import { getImage } from 'astro:assets';
import avatar from '../assets/avatar.png';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoLatin from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const { title = 'Luka Šikić', description, lang = 'en' } = Astro.props;
const s = strings[lang];
const resolvedDescription = description || s.home.description;
const siteOrigin = Astro.site || new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, siteOrigin);
const alternatePath = lang === 'hr' && Astro.url.pathname.startsWith('/hr/404')
  ? '/404.html'
  : altPath(Astro.url.pathname, lang);
const alternate = new URL(alternatePath, siteOrigin);
const english = lang === 'en' ? canonical : alternate;
const croatian = lang === 'hr' ? canonical : alternate;
const socialImage = new URL('/og.jpg', siteOrigin);
const locale = lang === 'hr' ? 'hr_HR' : 'en_US';
const alternateLocale = lang === 'hr' ? 'en_US' : 'hr_HR';
const schemaAvatar = await getImage({
  src: avatar,
  width: 640,
  format: 'webp',
  quality: 82,
});
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Luka Šikić',
  url: new URL('/', siteOrigin).toString(),
  image: new URL(schemaAvatar.src, siteOrigin).toString(),
  jobTitle: lang === 'hr'
    ? 'Docent statistike i znanosti o podacima'
    : 'Assistant Professor of Statistics and Data Science',
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: lang === 'hr' ? 'Hrvatsko katoličko sveučilište' : 'Croatian Catholic University',
    url: 'https://www.unicath.hr/',
  },
  sameAs: [
    'https://github.com/lusiki',
    'https://scholar.google.com/citations?user=qOGfRvkAAAAJ&hl=en',
    'https://www.linkedin.com/in/luka-sikic-662ba869/',
  ],
};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={resolvedDescription} />
  <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0A0A0A" media="(prefers-color-scheme: dark)" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Luka Šikić" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={resolvedDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={locale} />
  <meta property="og:locale:alternate" content={alternateLocale} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Luka Šikić — Econometrics, Data Science, and AI in Economic Research" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={resolvedDescription} />
  <meta name="twitter:image" content={socialImage} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={english} />
  <link rel="alternate" hreflang="hr" href={croatian} />
  <link rel="alternate" hreflang="x-default" href={english} />
  <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />
  <title>{title}</title>
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <slot name="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script is:inline>
    (function () {
      try {
        const t = localStorage.getItem('ds-theme');
        if (t) document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
      // Set before first paint so the reveal styles apply without a flash of
      // already-visible content. Nothing depends on this for readability.
      document.documentElement.classList.add('has-js');
    })();
  </script>
</head>
<body>
  <a class="skip-link" href="#main-content">{s.common.skipToContent}</a>
  <Nav lang={lang} />
  <main class="container" id="main-content">
    <slot />
  </main>
  <Footer lang={lang} />
  <script is:inline>
    (function () {
      const root = document.documentElement;
      const KEY = 'ds-theme';
      const btn = document.getElementById('themeToggle');
      if (!btn) return;
      const systemDark = () => matchMedia('(prefers-color-scheme: dark)').matches;
      const currentTheme = () => root.getAttribute('data-theme') || (systemDark() ? 'dark' : 'light');
      const updateState = () => {
        const theme = currentTheme();
        btn.setAttribute('aria-pressed', String(theme === 'dark'));
        btn.setAttribute('data-theme-state', theme);
      };
      updateState();
      btn.addEventListener('click', () => {
        const cur = currentTheme();
        const next = cur === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem(KEY, next); } catch (e) {}
        updateState();
      });
    })();
  </script>
  <script is:inline>
    (function () {
      const sections = document.querySelectorAll('.section');
      const hero = document.querySelectorAll('.hero__main > *, .hero__portrait');
      const show = el => el.classList.add('is-in');
      const showEverything = () => {
        sections.forEach(show);
        hero.forEach(show);
      };

      // Reduced motion or no IntersectionObserver: reveal immediately and stop.
      if (
        matchMedia('(prefers-reduced-motion: reduce)').matches ||
        !('IntersectionObserver' in window)
      ) {
        showEverything();
        return;
      }

      // Two frames so the initial hidden state is painted and the entrance
      // actually transitions rather than snapping.
      requestAnimationFrame(() => requestAnimationFrame(() => hero.forEach(show)));

      const io = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            show(entry.target);
            io.unobserve(entry.target);
          });
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
      );
      sections.forEach(section => io.observe(section));

      // Safety net: if anything above misbehaves, never leave content hidden.
      setTimeout(showEverything, 3000);
    })();
  </script>
</body>
</html>
