{
  "name": "lukasikic-info",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "prepare:ai": "node scripts/prepare-ai-site.mjs",
    "prebuild": "npm run prepare:ai",
    "build": "astro build",
    "check": "astro check",
    "check:links": "node scripts/check-internal-links.mjs",
    "format": "prettier --write \"src/**/*.ts\" astro.config.mjs package.json \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" astro.config.mjs package.json \"scripts/*.mjs\"",
    "validate": "npm run format:check && npm run check && npm run build && npm run check:links",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
